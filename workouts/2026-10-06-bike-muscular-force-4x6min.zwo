<workout_file>
  <author>Robotina</author>
  <name>Bike - Muscular Force 4x6min</name>
  <description>Friel Base 1 muscular force. Warm up easy, then 4x6 min big-gear low-cadence intervals seated. Smooth pedal pressure, no bouncing.</description>
  <sportType>bike</sportType>
  <tags><tag name="70.3"/></tags>
  <workout>
    <Warmup Duration="600" PowerLow="0.5" PowerHigh="0.6" Cadence="90"/>
    <IntervalsT Repeat="4" OnDuration="360" OffDuration="240" OnPower="0.79" OffPower="0.5" Cadence="60" CadenceResting="90"/>
    <Cooldown Duration="600" PowerLow="0.5" PowerHigh="0.5"/>
  </workout>
</workout_file>
