+// Local patch: route the login browser through the environment's egress proxy,
+// which Playwright does not pick up automatically.
+function proxyFromEnv():
+  | { server: string; username?: string; password?: string }
+  | undefined {
+  const raw =
+    process.env.TP_PROXY_URL ||
+    process.env.HTTPS_PROXY ||
+    process.env.https_proxy;
+  if (!raw) return undefined;
+  try {
+    const u = new URL(raw);
+    const proxy: { server: string; username?: string; password?: string } = {
+      server: `${u.protocol}//${u.host}`,
+    };
+    if (u.username) proxy.username = decodeURIComponent(u.username);
+    if (u.password) proxy.password = decodeURIComponent(u.password);
+    return proxy;
+  } catch {
+    return undefined;
+  }
+}
